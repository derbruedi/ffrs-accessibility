<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ist in Windows 10/11 enthalten: die Exe laeuft ohne zusaetzliche Laufzeit. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FFRSAccess-Setup</AssemblyName>
    <RootNamespace>FFRSSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>FINAL FANTASY RESONANCE Zugang</Product>
    <AssemblyTitle>FINAL FANTASY RESONANCE Zugang Installation</AssemblyTitle>
    <!-- build_package.ps1 setzt beides aus der Datei VERSION (z. B. 0.1.0 und 0.1.0b). -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup Condition="'$(PayloadZip)' != ''">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
